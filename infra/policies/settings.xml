<!--
  Excel filler gateway: the app's central settings (GET /settings), read by every PC at startup.

  The answer is the named value "excel-filler-settings", a JSON object:
    {"deployment": "<Foundry deployment of Claude>", "minimum_version": "0.1.0", "notice": ""}
  - deployment: the Claude deployment the apps use; change it to switch every PC to another model.
  - minimum_version: older app versions refuse to run and ask to install the latest one.
  - notice: a message shown at the top of every window (empty: none).

  No sign-in needed (these settings are not secret, and they must be readable before signing in);
  limited per IP address. <base /> is left out of inbound on purpose: the API's policy (token
  check, per-user limits) does not apply to this operation.
-->
<policies>
  <inbound>
    <rate-limit-by-key calls="60" renewal-period="60" counter-key="@(context.Request.IpAddress)" />
    <return-response>
      <set-status code="200" reason="OK" />
      <set-header name="Content-Type" exists-action="override">
        <value>application/json</value>
      </set-header>
      <set-header name="Cache-Control" exists-action="override">
        <value>no-store</value>
      </set-header>
      <set-body>{{excel-filler-settings}}</set-body>
    </return-response>
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
