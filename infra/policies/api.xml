<!--
  Excel filler gateway: rules for Claude calls (operations using <base />; not /settings).
  Who may use Excel filler is decided by Entra ID when the person signs in (only assigned users get
  a token for this API, with the Excel.Filler.User role); this only verifies that token.

  1. Who: a valid Entra ID token of our tenant, issued to the Excel filler desktop app for this API,
     for a user who has the Excel.Filler.User role (granted through the "Excel filler users" group).
  2. How much: a per-user limit per minute and per day.

  Values in {{...}} are API Management named values (see main.bicep).
-->
<policies>
  <inbound>
    <base />
    <!-- 1. Who -->
    <validate-azure-ad-token tenant-id="{{excel-filler-tenant-id}}" header-name="Authorization"
        failed-validation-httpcode="401" output-token-variable-name="jwt"
        failed-validation-error-message="Sign in with your work account to use Excel filler.">
      <client-application-ids>
        <application-id>{{excel-filler-client-app-id}}</application-id>
      </client-application-ids>
      <audiences>
        <audience>{{excel-filler-api-app-id}}</audience>
        <audience>api://{{excel-filler-api-app-id}}</audience>
      </audiences>
    </validate-azure-ad-token>
    <set-variable name="user" value="@(((Jwt)context.Variables["jwt"]).Claims.GetValueOrDefault("oid", "unknown"))" />
    <set-variable name="appVersion" value="@(context.Request.Headers.GetValueOrDefault("x-app-version", "unknown"))" />
    <choose>
      <when condition="@(!((Jwt)context.Variables["jwt"]).Claims.GetValueOrDefault("roles", "").Split(',').Contains("Excel.Filler.User"))">
        <return-response>
          <set-status code="403" reason="Forbidden" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>{"type": "error", "error": {"type": "permission_error", "message": "Your account is not allowed to use Excel filler. Ask IT to add you to the Excel filler users group."}}</set-body>
        </return-response>
      </when>
    </choose>

    <!-- 2. How much, per user -->
    <rate-limit-by-key calls="{{excel-filler-calls-per-minute}}" renewal-period="60"
        counter-key="@((string)context.Variables["user"])" />
    <quota-by-key calls="{{excel-filler-calls-per-day}}" renewal-period="86400"
        counter-key="@((string)context.Variables["user"])" />

  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
