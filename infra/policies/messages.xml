<!--
  Excel filler gateway: calls to Claude (POST /v1/messages).

  Who may call and how much: the API's policy (api.xml), applied first by <base />.
  3. What is recorded: one metric and one trace per request, with the user's object id and the
     app version; never the content of the request or the response.
  4. Where to: the Foundry deployment, called with the gateway's own identity (managed identity).
     The employee's token never reaches Foundry, and no key exists on any PC.

  Values in {{...}} are API Management named values (see main.bicep); change them in the portal
  (API Management > Named values) or by redeploying.
-->
<policies>
  <inbound>
    <base />
    <!-- 3. What is recorded (Application Insights): who and which version, no content -->
    <emit-metric name="Requests" namespace="excel-filler">
      <dimension name="User" value="@((string)context.Variables["user"])" />
      <dimension name="App version" value="@((string)context.Variables["appVersion"])" />
    </emit-metric>
    <trace source="excel-filler" severity="information">
      <message>Claude request</message>
      <metadata name="user" value="@((string)context.Variables["user"])" />
      <metadata name="appVersion" value="@((string)context.Variables["appVersion"])" />
    </trace>

    <!-- 4. Where to: Foundry, with the gateway's identity -->
    <set-header name="api-key" exists-action="delete" />
    <set-header name="x-app-name" exists-action="delete" />
    <authentication-managed-identity resource="{{excel-filler-foundry-token-resource}}" />
    <set-backend-service backend-id="excel-filler-foundry" />
  </inbound>
  <backend>
    <!-- Streamed answers (server-sent events) go through as they come; long documents take time. -->
    <forward-request timeout="600" buffer-response="false" />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
